#!/usr/bin/perl
# timeout: GNU coreutils `timeout` 的最小可用替代(macOS 自带 BSD userland 没有它)
#
# 为什么存在:agent 反复写出 `timeout 300 <cmd>` 然后收到 rc=127 command not found,
# 把"命令超时保护"整段静默失效 —— 更糟的是 rc=127 会被误判成"环境坏了"。
# 装这个 shim 后 macOS 本机与远端 Linux 行为一致,不必再区分。
#
# 用法(兼容 GNU 常用形式):
#   timeout [-k KILL_AFTER] [-s SIG] DURATION COMMAND [ARG...]
#   timeout 300 pytest ...
#   timeout -k 10 300 ./long_job.sh
#
# DURATION 支持 GNU 后缀:30 / 30s / 5m / 2h / 1d
# 退出码遵循 GNU 约定:超时杀掉 -> 124;命令本身的退出码原样透传;
#                     无法执行命令 -> 126/127
#
# 限制:不实现 --preserve-status / --foreground。需要完整语义就 brew install coreutils
#       然后用 gtimeout。

use strict;
use warnings;
use POSIX qw(:sys_wait_h);

my $signal    = 'TERM';
my $kill_after;

# ---- 解析选项 ----
while (@ARGV && $ARGV[0] =~ /^-/) {
    my $opt = shift @ARGV;
    if    ($opt eq '-k' || $opt eq '--kill-after') { $kill_after = shift @ARGV }
    elsif ($opt eq '-s' || $opt eq '--signal')     { $signal     = shift @ARGV }
    elsif ($opt eq '--help' || $opt eq '-h') {
        print "Usage: timeout [-k KILL_AFTER] [-s SIG] DURATION COMMAND [ARG...]\n";
        exit 0;
    }
    else {
        print STDERR "timeout: unrecognized option '$opt'\n";
        exit 125;
    }
}

my $duration = shift @ARGV;
unless (defined $duration && @ARGV) {
    print STDERR "Usage: timeout [-k KILL_AFTER] [-s SIG] DURATION COMMAND [ARG...]\n";
    exit 125;
}

# ---- DURATION 后缀换算 ----
sub to_seconds {
    my ($d) = @_;
    return undef unless $d =~ /^([0-9]*\.?[0-9]+)([smhd]?)$/;
    my ($n, $unit) = ($1, $2);
    my %mult = ('' => 1, s => 1, m => 60, h => 3600, d => 86400);
    return $n * $mult{$unit};
}

my $secs = to_seconds($duration);
unless (defined $secs) {
    print STDERR "timeout: invalid time interval '$duration'\n";
    exit 125;
}
my $kill_secs = defined $kill_after ? to_seconds($kill_after) : undef;

$signal =~ s/^SIG//;

# ---- 起子进程,自成进程组,便于整组收割 ----
my $pid = fork();
if (!defined $pid) {
    print STDERR "timeout: fork failed: $!\n";
    exit 125;
}

if ($pid == 0) {
    setpgrp(0, 0);
    exec { $ARGV[0] } @ARGV
        or do {
            my $rc = ($! == 2) ? 127 : 126;   # ENOENT -> 127, 其余 -> 126
            print STDERR "timeout: failed to run command '$ARGV[0]': $!\n";
            exit $rc;
        };
}

my $timed_out = 0;

# SIGALRM 到点先发温和信号,再按 -k 补一刀
$SIG{ALRM} = sub {
    $timed_out = 1;
    kill "-$signal", $pid;
    if (defined $kill_secs) {
        alarm 0;
        $SIG{ALRM} = sub { kill '-KILL', $pid };
        alarm $kill_secs;
    }
};

# 自己被打断时,不把子进程留成孤儿
for my $s (qw(INT TERM HUP)) {
    $SIG{$s} = sub { kill "-$s", $pid; waitpid($pid, 0); exit 128 + 15 };
}

alarm $secs;
waitpid($pid, 0);
my $status = $?;
alarm 0;

exit 124 if $timed_out;

if ($status & 127) { exit 128 + ($status & 127) }
exit $status >> 8;
